rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to validate contact form
    function isValidContactMessage() {
      let incomingData = request.resource.data;
      return incomingData.keys().hasAll(['name', 'email', 'message']) 
          && incomingData.name is string && incomingData.name.size() > 0
          && incomingData.email is string && incomingData.email.matches('.*@.*')
          && incomingData.message is string && incomingData.message.size() > 0;
    }

    // Courses: Everyone can read, only authenticated users (admins) can write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Blogs: Everyone can read, only authenticated users (admins) can write
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Contacts: Everyone can submit (create) with VALID data.
    // Only authenticated users (admins) can read/delete.
    match /contacts/{contactId} {
      allow create: if isValidContactMessage();
      allow read, update, delete: if isAuthenticated();
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
